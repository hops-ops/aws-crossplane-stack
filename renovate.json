{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "crossplane": {
    "managerFilePatterns": ["/\\.yaml$/", "/\\.yaml\\.gotmpl$/"]
  },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates that pass all checks",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Disable automatic updates for all hops-ops Docker images",
      "matchDatasources": ["docker"],
      "enabled": false,
      "matchPackageNames": ["/^hops-ops//"]
    },
    {
      "description": "Group all AWS provider packages together for batched updates",
      "matchPackageNames": ["/provider-family-aws/", "/provider-aws-.*/"],
      "groupName": "aws-providers"
    },
    {
      "description": "Require manual review for Crossplane core upgrades",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["crossplane"],
      "automerge": false
    },
    {
      "description": "Use feat(deps): commit prefix for hops-ops Crossplane packages (github-releases datasource)",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "semanticCommitType": "feat",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Use fix(deps): commit prefix for other Crossplane packages from Docker registries",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "semanticCommitType": "feat",
      "semanticCommitScope": "deps"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "hops-ops Crossplane configurations (tracked via GitHub Releases)",
      "managerFilePatterns": ["apis/**/configuration.yaml", "upbound.yaml"],
      "matchStrings": [
        "\\s*(configuration|function|package|provider):\\s*ghcr\\.io/hops-ops/(?<depName>.*?)\\s*version:\\s*(\"|')>=(?<currentValue>.*?)(\"|')\\s*"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "hops-ops/{{depName}}"
    },
    {
      "customType": "regex",
      "description": "hops-ops packages in E2E tests (tracked via GitHub Releases)",
      "managerFilePatterns": ["tests/**/main.k"],
      "matchStrings": [
        "package\\s*=\\s*\"ghcr\\.io/(?<depName>hops-ops/[^:]+):v?(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "{{depName}}"
    },
    {
      "customType": "regex",
      "description": "Annotated provider runtime defaults",
      "managerFilePatterns": ["functions/*-provider/000-state-init.yaml.gotmpl"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s+\\{\\{- \\$packageVersion := \\$pkg\\.version \\| default \\\"(?<currentValue>[^\\\"]+)\\\" \\}\\}"
      ]
    },
    {
      "customType": "regex",
      "description": "Crossplane Helm chart runtime and test defaults",
      "managerFilePatterns": [
        "functions/render/010-state-status.yaml.gotmpl",
        "functions/render/100-crossplane-helm-release.yaml.gotmpl",
        "tests/test-render/main.k"
      ],
      "matchStrings": [
        "version:\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "\\\"chartVersion\\\"\\s+\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"",
        "version\\s+=\\s+\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "crossplane",
      "registryUrlTemplate": "https://charts.crossplane.io/stable"
    },
    {
      "customType": "regex",
      "description": "External provider package assertions in render tests",
      "managerFilePatterns": ["tests/test-*-provider-stack/main.k"],
      "matchStrings": [
        "package\\s*=\\s*\\\"xpkg\\.crossplane\\.io/(?<depName>[^:\\\"\\s]+):(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://xpkg.crossplane.io",
      "packageNameTemplate": "{{depName}}"
    },
    {
      "customType": "regex",
      "description": "Crossplane packages from other registries (tracked via Docker tags)",
      "managerFilePatterns": ["apis/**/configuration.yaml", "upbound.yaml"],
      "matchStrings": [
        "\\s*(configuration|function|package|provider):\\s*(?<registryUrl>[^/]+)\\/(?<orgName>[^/]+)\\/(?<repoName>[^/\\s]+)\\s*version:\\s*(\"|')>=(?<currentValue>.*?)(\"|')\\s*"
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://{{registryUrl}}",
      "depNameTemplate": "{{orgName}}/{{repoName}}",
      "packageNameTemplate": "{{orgName}}/{{repoName}}"
    }
  ]
}
