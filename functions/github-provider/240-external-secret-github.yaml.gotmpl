# code: language=yaml
{{- if and $state.enabled $state.providerConfig.render $state.externalSecret.enabled $state.externalSecret.remoteKey }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: externalsecret-github
  annotations:
    {{ setResourceNameAnnotation "externalsecret-github" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: {{ $state.providerConfig.secretName }}
        namespace: {{ $state.providerConfig.secretNamespace }}
      spec:
        refreshInterval: 1h
        secretStoreRef:
          name: {{ $state.externalSecret.secretStoreName }}
          kind: {{ $state.externalSecret.secretStoreKind }}
        target:
          name: {{ $state.providerConfig.secretName }}
          creationPolicy: Owner
          {{- if $state.externalSecret.githubApp.enabled }}
          template:
            engineVersion: v2
            data:
              {{ $state.externalSecret.targetKey }}: |
                {"app_auth":[{"id":"{{ `{{ .githubAppID }}` }}","installation_id":"{{ `{{ .githubAppInstallationID }}` }}","pem_file":{{ `{{ .githubAppPrivateKey | toJson }}` }}}],"owner":{{ $state.github.org | toJson }}}
          {{- end }}
        data:
        {{- if $state.externalSecret.githubApp.enabled }}
        - secretKey: githubAppID
          remoteRef:
            key: {{ $state.externalSecret.remoteKey }}
            property: {{ $state.externalSecret.githubApp.appIdKey }}
        - secretKey: githubAppInstallationID
          remoteRef:
            key: {{ $state.externalSecret.remoteKey }}
            property: {{ $state.externalSecret.githubApp.installationIdKey }}
        - secretKey: githubAppPrivateKey
          remoteRef:
            key: {{ $state.externalSecret.remoteKey }}
            property: {{ $state.externalSecret.githubApp.privateKeyKey }}
        {{- else }}
        - secretKey: {{ $state.externalSecret.targetKey }}
          remoteRef:
            key: {{ $state.externalSecret.remoteKey }}
        {{- end }}
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}
{{- end }}
