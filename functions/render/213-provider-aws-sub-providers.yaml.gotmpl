# code: language=yaml
{{- if $state.providers.aws.enabled }}
{{- $awsProviders := $state.providers.aws.providers }}
{{- $defaultRc := $state.providers.aws.runtimeConfig }}
{{- $providerDefaults := dict
  "ec2" (dict "requestsCpu" "35m" "requestsMemory" "684Mi" "memory" "2Gi")
  "eks" (dict "requestsCpu" "23m" "requestsMemory" "641Mi" "memory" "1536Mi")
  "iam" (dict "requestsCpu" "23m" "requestsMemory" "879Mi" "memory" "1536Mi")
  "rds" (dict "requestsCpu" "23m" "requestsMemory" "561Mi" "memory" "1536Mi")
  "s3" (dict "requestsCpu" "23m" "requestsMemory" "934Mi" "memory" "1536Mi")
}}
{{- range $subName, $subConfig := $awsProviders }}
{{- $rc := $subConfig.runtimeConfig | default dict }}
{{- $subDefaults := get $providerDefaults $subName | default (dict "requestsCpu" "23m" "requestsMemory" "561Mi" "memory" "1536Mi") }}
{{- $hasDrc := or (gt (len $rc) 0) (hasKey $providerDefaults $subName) }}
{{- if $hasDrc }}
{{- $reqCpu := $rc.requestsCpu | default ($defaultRc.requestsCpu | default $subDefaults.requestsCpu) }}
{{- $reqMemory := $rc.requestsMemory | default ($defaultRc.requestsMemory | default $subDefaults.requestsMemory) }}
{{- $limCpu := $rc.cpu | default ($defaultRc.cpu | default ($subDefaults.cpu | default "")) }}
{{- $limMemory := $rc.memory | default ($defaultRc.memory | default ($subDefaults.memory | default "")) }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: drc-aws-{{ $subName }}
  annotations:
    {{ setResourceNameAnnotation (printf "drc-aws-%s" $subName) }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: pkg.crossplane.io/v1beta1
      kind: DeploymentRuntimeConfig
      metadata:
        name: {{ $state.providers.aws.providerConfigName }}-aws-{{ $subName }}
      spec:
        deploymentTemplate:
          spec:
            selector: {}
            template:
              spec:
                containers:
                - name: package-runtime
                  resources:
                    {{- if or $limCpu $limMemory }}
                    limits:
                      {{- if $limCpu }}
                      cpu: {{ $limCpu }}
                      {{- end }}
                      {{- if $limMemory }}
                      memory: {{ $limMemory }}
                      {{- end }}
                    {{- end }}
                    requests:
                      cpu: {{ $reqCpu }}
                      memory: {{ $reqMemory }}
                {{- if $state.nodePool.enabled }}
                nodeSelector:
                  workload-type: crossplane
                tolerations:
                - key: crossplane
                  operator: Equal
                  value: "true"
                  effect: NoSchedule
                {{- end }}
        serviceAccountTemplate:
          metadata:
            name: {{ $state.podIdentity.saName }}
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}
{{- end }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: provider-aws-{{ $subName }}
  annotations:
    {{ setResourceNameAnnotation (printf "provider-aws-%s" $subName) }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: pkg.crossplane.io/v1
      kind: Provider
      metadata:
        name: crossplane-contrib-provider-aws-{{ $subName }}
      spec:
        package: xpkg.crossplane.io/crossplane-contrib/provider-aws-{{ $subName }}:v2.5.0
        skipDependencyResolution: true
        runtimeConfigRef:
          {{- if $hasDrc }}
          name: {{ $state.providers.aws.providerConfigName }}-aws-{{ $subName }}
          {{- else }}
          name: {{ $state.providers.aws.providerConfigName }}-aws
          {{- end }}
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}
{{- end }}
{{- end }}
