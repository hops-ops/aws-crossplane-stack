# code: language=yaml
{{- if $state.providers.helm.enabled }}
{{- $rc := $state.providers.helm.runtimeConfig }}
{{- $reqCpu := $rc.requestsCpu | default "23m" }}
{{- $reqMemory := $rc.requestsMemory | default "600Mi" }}
{{- $limCpu := $rc.cpu | default "" }}
{{- $limMemory := $rc.memory | default "768Mi" }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: drc-helm
  annotations:
    {{ setResourceNameAnnotation "drc-helm" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: pkg.crossplane.io/v1beta1
      kind: DeploymentRuntimeConfig
      metadata:
        name: {{ $state.providers.helm.providerConfigName }}-helm
      spec:
        deploymentTemplate:
          spec:
            selector: {}
            template:
              spec:
                containers:
                - name: package-runtime
                  resources:
                    {{- if or $limCpu $limMemory }}
                    limits:
                      {{- if $limCpu }}
                      cpu: {{ $limCpu }}
                      {{- end }}
                      {{- if $limMemory }}
                      memory: {{ $limMemory }}
                      {{- end }}
                    {{- end }}
                    requests:
                      cpu: {{ $reqCpu }}
                      memory: {{ $reqMemory }}
                {{- if $state.nodePool.enabled }}
                nodeSelector:
                  workload-type: crossplane
                tolerations:
                - key: crossplane
                  operator: Equal
                  value: "true"
                  effect: NoSchedule
                {{- end }}
        serviceAccountTemplate:
          metadata:
            name: {{ $state.providers.helm.providerConfigName }}-helm
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}
{{- end }}
