# code: language=yaml
{{- if $state.nodePool.enabled }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: nodepool-crossplane
  annotations:
    {{ setResourceNameAnnotation "nodepool-crossplane" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: karpenter.sh/v1
      kind: NodePool
      metadata:
        name: {{ $state.nodePool.name }}
      spec:
        template:
          metadata:
            labels:
              workload-type: crossplane
          spec:
            nodeClassRef:
              group: eks.amazonaws.com
              kind: NodeClass
              name: {{ $state.nodePool.nodeClassName }}
            taints:
            - key: crossplane
              value: "true"
              effect: NoSchedule
            requirements: {{ $state.nodePool.requirements | toJson }}
        limits: {{ $state.nodePool.limits | toJson }}
        disruption: {{ $state.nodePool.disruption | toJson }}
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}
# ==============================================================================
# Usage: delete the crossplane Helm release before the NodePool so the chart's
# pods drain (gracefully evicted onto whatever the next valid node is, if any)
# before Karpenter tears the dedicated nodes down. Rendered unconditionally
# when nodePool.enabled — NOT gated on observed readiness, so a transient
# Ready=False on either dep cannot un-render this safeguard while a real
# delete is in progress.
# ==============================================================================
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: delete-crossplane-before-nodepool
  annotations:
    {{ setResourceNameAnnotation "usage-nodepool" }}
  labels: {{ $state.labels | toJson }}
spec:
  of:
    apiVersion: kubernetes.m.crossplane.io/v1alpha1
    kind: Object
    resourceRef:
      name: nodepool-crossplane
  by:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $state.crossplane.releaseName }}
  replayDeletion: true
{{- end }}
