# code: language=yaml
{{- $xr := getCompositeResource . }}
{{- $s := $state.status }}
---
apiVersion: {{ $xr.apiVersion }}
kind: {{ $xr.kind }}
status:
  ready: {{ $s.ready }}
  crossplane:
    ready: {{ $s.crossplane.ready }}
    namespace: {{ $s.crossplane.namespace }}
    releaseName: {{ $s.crossplane.releaseName }}
    chartVersion: {{ $s.crossplane.chartVersion }}
  nodePool:
    enabled: {{ $s.nodePool.enabled }}
    ready: {{ $s.nodePool.ready }}
    {{- if $s.nodePool.enabled }}
    name: {{ $s.nodePool.name }}
    {{- end }}
