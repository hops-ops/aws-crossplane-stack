# code: language=yaml
{{- if $state.providers.zitadel.enabled }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: provider-zitadel
  annotations:
    {{ setResourceNameAnnotation "provider-zitadel" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    manifest:
      apiVersion: pkg.crossplane.io/v1
      kind: Provider
      metadata:
        name: crossplane-contrib-provider-upjet-zitadel
      spec:
        package: xpkg.crossplane.io/crossplane-contrib/provider-upjet-zitadel:v0.1.1
        skipDependencyResolution: true
        runtimeConfigRef:
          name: zitadel
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}
{{- end }}
